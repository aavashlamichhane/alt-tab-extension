{
  "manifest_version": 3,
  "name": "Edge Alt-Tab",
  "short_name": "Alt-Tab",
  "version": "1.4.4",
  "minimum_chrome_version": "121",
  "author": "Aavash",
  "description": "Switch tabs in MRU order with a beautiful Fluent-inspired overlay. Mimics the native Alt-Tab experience in your browser.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "favicon"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Open recently used tabs",
    "default_popup": "switcher.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-tab": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Cycle through recently used tabs"
    },
    "cycle-backward": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Cycle backwards through recently used tabs"
    },
    "quick-switch": {
      "description": "Switch immediately to the previous tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    { "resources": ["switcher.html"], "matches": ["<all_urls>"] }
  ]
}
