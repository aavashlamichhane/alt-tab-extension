{
  "manifest_version": 3,
  "name": "Edge Alt-Tab",
  "version": "1.1",
  "description": "MRU (Most Recently Used) tab switcher with Fluent and Simple themes.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-tab": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Cycle through recently used tabs"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
