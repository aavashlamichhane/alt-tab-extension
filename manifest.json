{
  "manifest_version": 3,
  "name": "Edge Alt-Tab",
  "short_name": "Alt-Tab",
  "version": "1.1",
  "author": "Aavash",
  "description": "Switch tabs in MRU order with a beautiful Fluent-inspired overlay. Mimics the native Alt-Tab experience in your browser.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-tab": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Cycle through recently used tabs"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
